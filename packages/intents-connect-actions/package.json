{
  "name": "@aurora-is-near/intents-connect-actions",
  "version": "0.0.0",
  "private": true,
  "description": "Intents Connect actions built in this monorepo (Aave V3 borrow), with TypeScript twins of their resolvers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.js",
  "source": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "build": "vite build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@aurora-is-near/intents-connect": "^7.31.0"
  },
  "devDependencies": {
    "@aurora-is-near/intents-connect": "^7.31.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "starlark-wasm": "0.0.4"
  }
}
