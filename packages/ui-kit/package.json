{
  "name": "@aurora-is-near/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Borrow design language: tokens, theme and base React components",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.js",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "build": "vite build",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "^6.9.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "10.6.7"
  }
}
