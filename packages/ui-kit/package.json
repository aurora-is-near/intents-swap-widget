{
  "name": "@aurora-is-near/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Borrow design language: tokens, theme and base React components",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.js",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "build": "vite build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
