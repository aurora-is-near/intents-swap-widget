{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/vaults-fyi/:path*",
      "destination": "/api/vaults-fyi?path=:path*"
    },
    { "source": "/positions", "destination": "/positions.html" },
    { "source": "/swap", "destination": "/swap.html" }
  ],
  "headers": [
    {
      "source": "/storybook/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
