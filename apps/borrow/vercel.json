{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/vaults-fyi/:path*",
      "destination": "/api/vaults-fyi?path=:path*"
    },
    {
      "source": "/((?!storybook/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
