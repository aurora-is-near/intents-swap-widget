# Reown (WalletConnect Cloud) project id for the wallet connect modal. Public:
# it ships in the bundle. Register Borrow's own project in Reown Cloud and list
# the site's domains there for production. Left empty, the app falls back to
# the shared Aurora id from @aurora-is-near/intents-connect-wallet
# (connect/projectId.ts), which is meant for development only.
VITE_REOWN_PROJECT_ID=

# REQUIRED. Public: it ships in the bundle. The one API key for both the
# Intents Connect API (sent as x-api-key on the SDK's create calls; its fee
# configuration is the borrow fee) and the Aurora intents API
# (intents-api.aurora.dev, the token list and wallet balances, in the URL
# path). Unset, the app logs a configuration error at start-up, connected
# users see "Balances did not load" and every borrow fails at creation.
VITE_INTENTS_API_KEY=

# Public. The Intents Connect API. Defaults to
# https://intents-connect-alpha-api.aurora.dev.
VITE_INTENTS_CONNECT_API_URL=
# Public. The hosted actions API Borrow resolves its borrow steps from (the
# pinned `aave-v3-borrow` action). Defaults to
# https://intents-connect-actions-demo.aurora.dev.
VITE_INTENTS_CONNECT_ACTIONS_API_URL=

# Public. JSON-RPC endpoints for reading the Aave V3 markets on Base and
# Arbitrum. Default to https://base-rpc.publicnode.com and
# https://arbitrum-one-rpc.publicnode.com, which may rate-limit: set your own
# for production.
VITE_RPC_URL_BASE=
VITE_RPC_URL_ARB=

