# Reown (WalletConnect Cloud) project id for the wallet connect modal. Public:
# it ships in the bundle. Register Borrow's own project in Reown Cloud and list
# the site's domains there for production. Left empty, the app falls back to
# the shared Aurora id from @aurora-is-near/intents-connect-wallet
# (connect/projectId.ts), which is meant for development only.
VITE_REOWN_PROJECT_ID=

# Intents Connect API key, for the API-key proxy ONLY: the Vite dev/preview
# middleware locally, the Vercel Edge Function api/intents-connect.ts
# in production (set it in the Vercel project's environment). Server-side:
# never prefix it with VITE_, or Vite inlines it into the bundle. Without it
# the proxy answers 500 and create calls fail.
INTENTS_CONNECT_API_KEY=
# Optional, server-side: the API the proxy forwards to. Defaults to
# VITE_INTENTS_CONNECT_API_URL, then the alpha API.
INTENTS_CONNECT_API_URL=

# Public. The Intents Connect API for every call that needs no key. Defaults to
# https://intents-connect-alpha-api.aurora.dev.
VITE_INTENTS_CONNECT_API_URL=
# Public. Where create calls go so the proxy can add the key; relative paths
# resolve against the page's origin. Defaults to /api/intents-connect.
VITE_INTENTS_CONNECT_API_KEY_PROXY_URL=/api/intents-connect

# Public. JSON-RPC endpoints for reading the Aave V3 markets on Base and
# Arbitrum. Default to https://base-rpc.publicnode.com and
# https://arbitrum-one-rpc.publicnode.com, which may rate-limit: set your own
# for production.
VITE_RPC_URL_BASE=
VITE_RPC_URL_ARB=

# Public. The Aurora intents API key (intents-api.aurora.dev) the SDK's
# balance hooks read tokens with: it travels in the URL path, as for the swap
# widget. Not the Intents Connect API key above.
VITE_INTENTS_API_KEY=
