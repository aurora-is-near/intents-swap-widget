{
  "name": "borrow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && yarn build:storybook",
    "build:storybook": "yarn workspace @aurora-is-near/ui-kit build-storybook --quiet --output-dir ../../apps/borrow/dist/storybook",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.ts,.tsx"
  },
  "dependencies": {
    "@aurora-is-near/intents-connect": "*",
    "@aurora-is-near/intents-connect-actions": "*",
    "@aurora-is-near/intents-connect-wallet": "*",
    "@aurora-is-near/ui-kit": "*",
    "@reown/appkit": "1.8.11",
    "@reown/appkit-adapter-ethers": "1.8.11",
    "@reown/appkit-adapter-solana": "1.8.11",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-phantom": "0.9.28",
    "@solana/wallet-adapter-solflare": "0.6.32",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.170.46",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "^6.9.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-perfectionist": "^4.15.1"
  }
}
