# Server-side key used by the local Vite dev/preview proxy. Never prefix with VITE_.
JUPITER_API_KEY=
# Optional server-side RPC URL (may include a provider credential).
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Public proxy endpoints. Defaults use the local Vite proxies.
# Static deployments need equivalent hosted proxies; Vite middleware is not bundled.
VITE_JUPITER_BUILD_URL=/api/jupiter/swap/v2/build
VITE_SOLANA_RPC_URL=/api/solana-rpc
