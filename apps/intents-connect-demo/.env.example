# Server-side key used by the proxy (Vite dev/preview middleware locally, the
# Vercel functions in api/ in production). Never prefix with VITE_.
JUPITER_API_KEY=
# Optional server-side RPC URL (may include a provider credential).
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Public proxy endpoints. Defaults use the bundled proxies (Vite locally, api/ on
# Vercel). Other static hosts need equivalent hosted proxies.
VITE_JUPITER_BUILD_URL=/api/jupiter/swap/v2/build
VITE_SOLANA_RPC_URL=/api/solana-rpc
