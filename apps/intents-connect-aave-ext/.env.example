# Copy to .env.local, fill in, and rebuild. Both end up in the bundle.

# Intents API and Intents Connect (alpha). Required.
VITE_INTENTS_API_KEY=
# Wallet balances (EVM, Solana) and the Solana RPC. Optional.
VITE_ALCHEMY_API_KEY=
# Optional: another Reown (WalletConnect) project for phone wallets. Its
# allowed domains must include app.aave.com. Defaults to the dev project.
# VITE_WALLETCONNECT_PROJECT_ID=
# Optional: another public TON Connect manifest (url, name, iconUrl). Defaults
# to github.com/aurora-is-near/ton-connect-manifest's.
# VITE_TONCONNECT_MANIFEST_URL=
# Optional: another Intents Connect service.
# VITE_INTENTS_CONNECT_API_URL=https://intents-connect-alpha-api.aurora.dev
